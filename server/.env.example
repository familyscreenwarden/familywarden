# Copy to .env (never commit .env). Only DATABASE_URL is required to start.

# Postgres 16 connection string
DATABASE_URL=postgres://postgres@127.0.0.1:5432/fsw

# Port the server listens on
PORT=3000

# Public address of the console; used in sign-in emails and Stripe return links
PUBLIC_URL=http://localhost:3000

# Long random string. Required when NODE_ENV=production.
# Changing it signs every parent out.
SESSION_SECRET=

# Set to 1 on a developer machine: the sign-in link is returned in the API
# response as devLink. Never set this in production.
DEV_LINKS=

# Set to production on the real server (Secure cookies, Origin check)
NODE_ENV=

# Number of reverse proxies in front of the server (e.g. 1). Leave empty when
# the server is reached directly. Needed for correct per-IP rate limits.
TRUST_PROXY=

# Amazon SES (sign-in emails). When any of these is empty the link is written
# to the server log instead of being sent.
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
MAIL_FROM_EMAIL=

# Stripe. Without STRIPE_SECRET_KEY the billing buttons answer 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: folder with the built web app (default ../web/dist)
WEB_DIST=

# Used by docker-compose.yml for the bundled database
POSTGRES_PASSWORD=
