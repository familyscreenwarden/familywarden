{
  "name": "family-screen-warden-server",
  "version": "1.0.0",
  "private": true,
  "description": "Family Screen Warden console server: parent API, device API, billing",
  "engines": { "node": ">=22" },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/seed.ts",
    "migrate": "tsx src/migrate-cli.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:unit": "tsx --test test/rules.test.ts test/crypto.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
